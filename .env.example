# Optional AI Assistant API Keys
# ─────────────────────────────────────────────────────────────────────────────
# The core ShikshaSetu AI application works WITHOUT any of these keys.
# They are only required to enable the optional AI Learning Assistant chatbot.
#
# Copy this file to .env and fill in the key(s) you have.
# Do NOT commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# OpenAI API Key (optional) — enables GPT-based AI assistant
OPENAI_API_KEY=

# Google Gemini API Key (optional) — enables Gemini-based AI assistant
GOOGLE_API_KEY=
